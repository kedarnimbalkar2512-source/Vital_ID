# Copy to backend/.env and fill in. Never commit the real file.

# Supabase: Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Only if your project still signs tokens with the legacy HS256 JWT secret (Project Settings -> API -> JWT Settings).
# Leave empty for the newer asymmetric signing keys; the backend then uses the project's JWKS.
SUPABASE_JWT_SECRET=
# Supabase: Project Settings -> Database -> Connection string (URI). The session pooler works well.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Groq: console.groq.com -> API Keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# A long random string; generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it invalidates every printed QR card.
QR_TOKEN_SECRET=

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Optional tuning (defaults shown)
# ACCESS_GRANT_HOURS=24
# BREAK_GLASS_HOURS=4
# COGNITIVE_DROP_THRESHOLD_PCT=20
# APP_TIMEZONE=Asia/Kolkata
